    {
      "collapsed": false,
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "id": 11,
      "title": "Bridge CPU (cores)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Process CPU across all threads. 1.0 = one core saturated. The WAL reader is single-threaded, so sustained 1.0 means it IS the bottleneck \u2014 that is what a quadratic PQconsumeInput looked like.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "rate(bridge_cpu_seconds_total[1m])",
          "legendFormat": "cores used",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20
          },
          "unit": "none",
          "min": 0,
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 1.0
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "id": 12,
      "title": "WAL lag: unconfirmed vs retained (MB)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Two different questions. UNCONFIRMED (from confirmed_flush_lsn) is the bridge's backlog and moves on every ACK \u2014 alert on this one for 'the bridge is stuck'. RETAINED (from restart_lsn) is what PostgreSQL keeps on disk and only advances at checkpoints, so it plateaus even when the bridge is fully caught up.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "bridge_wal_confirmed_lag_bytes / 1024 / 1024",
          "legendFormat": "unconfirmed (bridge backlog)",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "bridge_wal_lag_bytes / 1024 / 1024",
          "legendFormat": "retained by PostgreSQL",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          },
          "unit": "decmbytes",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 30
      },
      "id": 13,
      "title": "Suspended tables",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "A table is suspended when it has no primary key, a column the decoder cannot handle, or a row larger than BASE_BUF. Its CDC events are dropped and its clients are told to freeze. Any value > 0 needs the log: it names the table and the reason.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "bridge_refused_tables",
          "legendFormat": "suspended tables",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "rate(bridge_refused_events_dropped_total[1m])",
          "legendFormat": "events dropped/sec",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20
          },
          "unit": "none",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 30
      },
      "id": 14,
      "title": "Bridge memory (peak RSS)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "The event slab is pre-allocated at startup, so this should sit near 2^BASE_BUF x RING_BUFFER_COUNT plus ~400 MB of metadata and stay flat. Growth over time is a leak, not load.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "bridge_max_rss_bytes",
          "legendFormat": "peak RSS",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          },
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      }
    }
