        "w": 12,
        "x": 12,
        "y": 52
      },
      "id": 19,
      "title": "CDC stream window (seconds of history kept)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "bridge_cdc_window_seconds",
          "legendFormat": "{{stream}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "bridge_cdc_window_short",
          "legendFormat": "{{stream}} too short",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          },
          "unit": "s"
        },
        "overrides": []
      },
      "description": "How far back each CDC stream reaches. -1: the stream is empty. 'too short' = 1 when the window is under two generation cadences: a client away that long re-seeds from the chain."
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
