// Grafana Alloy on the VPS: scrapes the bridge, the NATS exporter and the services' memory, reads the three
// services' journal, and sends both to Grafana Cloud. The key comes from the
// environment (GRAFANA_PASSWORD, from .env.grafana), never from this file.

// ── metrics ──────────────────────────────────────────────────────────────────
prometheus.scrape "zebridge" {
  targets = [{__address__ = "127.0.0.1:27434", service = "cdc-bridge", environment = "production"}]
  job_name        = "zebridge"
  scrape_interval = "15s"
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

prometheus.scrape "nats" {
  targets = [{__address__ = "127.0.0.1:7777", service = "nats-server", environment = "production"}]
  job_name        = "nats"
  scrape_interval = "15s"
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

// The memory of the four services, as systemd counts it (`systemctl status` → Memory:),
// read from their cgroups. Only these four: docker_only drops every other cgroup and the
// allowlist brings these back; no Docker socket, so cAdvisor cannot see or touch the
// containers. A leak shows as a climb that never comes back down.
prometheus.exporter.cadvisor "units" {
  docker_only                 = true
  disable_root_cgroup_stats   = true
  enabled_metrics             = ["memory"]
  storage_duration            = "2m"
  raw_cgroup_prefix_allowlist = [
    "/system.slice/zebridge.service",
    "/system.slice/zebridge-sweeper.service",
    "/system.slice/nats.service",
    "/system.slice/airports.service",
    "/system.slice/routing.service",
  ]
}

prometheus.scrape "units" {
  targets         = prometheus.exporter.cadvisor.units.targets
  job_name        = "units"
  scrape_interval = "30s"
  forward_to      = [prometheus.relabel.units.receiver]
}

// Two series per unit: the working set (what systemd shows) and the RSS.
prometheus.relabel "units" {
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]
  rule {
    source_labels = ["__name__"]
    regex         = "container_memory_(working_set_bytes|rss)"
    action        = "keep"
  }
  rule {
    source_labels = ["id"]
    regex         = "/system.slice/(.+)\\.service"
    target_label  = "unit"
  }
  rule {
    source_labels = ["unit"]
    regex         = ""
    action        = "drop"
  }
  rule {
    target_label = "environment"
    replacement  = "production"
  }
}

prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = "https://prometheus-prod-55-prod-gb-south-1.grafana.net/api/prom/push"
    basic_auth {
      username = "2500869"                        // the Prometheus instance ID
      password = sys.env("GRAFANA_PASSWORD")
    }
  }
}

// ── logs: the systemd journal of the three units ─────────────────────────────
loki.relabel "journal" {
  forward_to = []
  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }
}

loki.source.journal "zebridge" {
  // only these units, and only what happens from now on
  matches       = "_SYSTEMD_UNIT=nats.service _SYSTEMD_UNIT=zebridge.service _SYSTEMD_UNIT=zebridge-sweeper.service _SYSTEMD_UNIT=airports.service _SYSTEMD_UNIT=routing.service"
  max_age       = "1h"
  relabel_rules = loki.relabel.journal.rules
  labels        = {environment = "production"}
  forward_to    = [loki.process.zebridge.receiver]
}

loki.process "zebridge" {
  // the unit names the service, with the labels the dev stack uses
  stage.match {
    selector = "{unit=~\"zebridge(-sweeper)?.service\"}"
    stage.static_labels {
      values = {service = "cdc-bridge"}
    }
    // the bridge logs `info(fleet): …`, `warning(preflight): …`: level and scope
    stage.regex {
      expression = "^(?P<level>debug|info|warning|error)\\((?P<scope>[a-z_]+)\\):"
    }
    stage.labels {
      values = {level = "", scope = ""}
    }
  }
  stage.match {
    selector = "{unit=\"nats.service\"}"
    stage.static_labels {
      values = {service = "nats-server"}
    }
    // nats-server logs `[pid] date time [INF] …`
    stage.regex {
      expression = "\\[(?P<level>INF|WRN|ERR|DBG|FTL|TRC)\\]"
    }
    stage.labels {
      values = {level = ""}
    }
  }
  // the airports responder (examples/10-airports): its own lines, and libzb's `info(nats): …`
  stage.match {
    selector = "{unit=\"airports.service\"}"
    stage.static_labels {
      values = {service = "airports"}
    }
    stage.regex {
      expression = "^(?P<level>debug|info|warning|error)\\("
    }
    stage.labels {
      values = {level = ""}
    }
  }
  // the routing responder (zb-respond, examples/13-routing): libzb's scoped lines
  stage.match {
    selector = "{unit=\"routing.service\"}"
    stage.static_labels {
      values = {service = "routing"}
    }
    stage.regex {
      expression = "^(?P<level>debug|info|warning|error)\\("
    }
    stage.labels {
      values = {level = ""}
    }
  }
  forward_to = [loki.write.grafana_cloud.receiver]
}

loki.write "grafana_cloud" {
  endpoint {
    url = "https://logs-prod-035.grafana.net/loki/api/v1/push"
    basic_auth {
      username = "1246111"                        // the Loki user
      password = sys.env("GRAFANA_PASSWORD")
    }
  }
}
