    {
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "id": 3,
      "title": "Slow consumers (new, per 5 min)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "delta(gnatsd_varz_slow_consumers[5m])",
          "legendFormat": "all",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "delta(gnatsd_varz_slow_consumer_stats_clients[5m])",
          "legendFormat": "clients",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "delta(gnatsd_varz_slow_consumer_stats_leafs[5m])",
          "legendFormat": "leaf nodes",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "delta(gnatsd_varz_slow_consumer_stats_routes[5m])",
          "legendFormat": "routes",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          },
          "min": 0
        },
        "overrides": []
      },
      "description": "A slow consumer is a connection the server cut because it did not read fast enough (its pending bytes passed max_pending, or a write missed write_deadline). Every disconnect loses the deliveries in flight: on phones over Wi-Fi this was the first sign of a link that could not keep up (NOTES §10jc). The server's log names the connection."
    },
