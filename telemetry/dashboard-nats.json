    {
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 36
      },
      "id": 13,
      "title": "MUTATIONS: bytes vs its cap",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "jetstream_stream_total_bytes{stream_name=\"MUTATIONS\"}",
          "legendFormat": "stored",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "jetstream_stream_limit_bytes{stream_name=\"MUTATIONS\"}",
          "legendFormat": "max_bytes",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          },
          "min": 0,
          "unit": "bytes"
        },
        "overrides": []
      },
      "description": "Client writes waiting for the bridge's ingress lanes. A write leaves the stream once applied (work-queue retention). With discard=new, a full stream refuses new writes at the door: the client's publish gets the error and keeps the write in its outbox. Verdicts are not here: they have their own stream, VERDICTS (NOTES §10jj)."
    },
    {
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 36
      },
      "id": 14,
      "title": "Writes waiting and verdicts kept",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "jetstream_stream_total_messages{stream_name=\"MUTATIONS\"}",
          "legendFormat": "writes waiting (MUTATIONS)",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "jetstream_stream_total_messages{stream_name=\"VERDICTS\"}",
          "legendFormat": "verdicts kept (VERDICTS)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          },
          "min": 0
        },
        "overrides": []
      },
      "description": "MUTATIONS holds the writes the bridge has not applied yet; a steady rise means the lanes are at their ceiling. VERDICTS keeps the last verdict per write for 2 h so a client that was offline can collect it; when full it drops the oldest (discard=old), which costs that client one replay, never a write."
    },
