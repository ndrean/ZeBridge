#!/bin/sh
#
# PROVIDE: zebridge_fast
# REQUIRE: LOGIN postgresql nats
# KEYWORD: shutdown

# Load FreeBSD rc subsystem
. /etc/rc.subr

# The name must match the filename
name="zebridge_fast"
rcvar="${name}_enable"

# Read settings from /etc/rc.conf
load_rc_config $name

# Set defaults if not defined in rc.conf
: ${zebridge_fast_enable:="NO"}
: ${zebridge_fast_user:="nobody"}
: ${zebridge_fast_env:=""}
: ${zebridge_fast_args:=""}

# The actual Zig binary to run
zebridge_bin="/opt/zebridge/zig-out/bin/bridge"

# PID and Log files
pidfile="/var/run/${name}_supervisor.pid"
child_pidfile="/var/run/${name}.pid"
logfile="/var/log/${name}.log"

# FreeBSD daemon(8) wrapper
command="/usr/sbin/daemon"

# daemon flags:
# -r : Restart the child process if it exits/crashes
# -P : PID file for the daemon supervisor itself
# -p : PID file for the child (your Zig app)
# -o : Append stdout and stderr to this log file
# -t : Title for the process (shows nicely in `top`)
command_args="-r -P ${pidfile} -p ${child_pidfile} -o ${logfile} -t ${name} ${zebridge_bin} ${zebridge_fast_args}"

# Export environment variables before running
export ${zebridge_fast_env}

run_rc_command "$1"