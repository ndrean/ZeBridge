# Copy to web-consumer/.env.local when running against the COMPOSE stack.
#
# Both endpoints come from the one nginx origin (edge/nginx.conf), so nothing here
# has to change when compose republishes the bridge or NATS on different host ports.
VITE_NATS_URL=ws://localhost:8090/nats
VITE_BRIDGE_URL=http://localhost:8090

# ⚠️ The compose broker is the PRE-OPERATOR world: `authorization { users: … }` with
# password principals and the bridge's nkey — no operator, no resolver. So the
# /enroll flow does NOT apply there (a minted JWT has no resolver to validate it,
# and the bridge answers `enrollment not configured` because ZB_SIGNING_SEED and
# ZB_ACCOUNT_PUB are deliberately not in .env.docker). Connect as a declared
# principal instead; scripts/native/ is the stack that mints creds.
VITE_PRINCIPAL=alice
VITE_PASSWORD=s3cret
