# ─────────────────────────────────────────────────────────────────────────────
# .env.docker — the compose stack, and nothing else.
#
# ⚠️ SELF-CONTAINED ON PURPOSE. It repeats values that also live in .env.admin
# and .env.bridge, and that is not the duplication those two files avoid: this
# describes a DIFFERENT deployment, where every address is a container name
# rather than 127.0.0.1. `docker compose` is the one-command dev evaluation;
# the host setup is the one you debug in. Mixing them is how a bridge ends up
# dialling a port that only exists on the other side.
#
#   docker compose -f docker-compose.full.yml --env-file .env.docker up -d
# ─────────────────────────────────────────────────────────────────────────────

# ─── the superuser: bootstrapping the container and running init.sql ─────────
PG_HOST=postgres-primary
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres_password
PG_DB=postgres
TARGET_DB=postgres
# What compose publishes to the host. Change these to run the compose stack
# BESIDE a native stack that already holds 4222/8222/8080/5432 — nothing inside
# the network is affected, containers always talk on the standard ports.
NATS_PUBLISH_PORT=4222
NATS_MONITOR_PUBLISH_PORT=8222
NATS_WS_PUBLISH_PORT=8080
PG_PUBLISH_PORT=55432
ADMIN_DATABASE_URL=postgres://postgres:postgres_password@postgres-primary:5432/postgres

# ─── the two roles init.sql creates, and the bridge then connects as ─────────
# ⚠️ Inside the network the host is `postgres-primary:5432`, NOT the published
# port — the bridge container never leaves the network to reach Postgres.
POSTGRES_READER_USER=bridge_reader
POSTGRES_READER_PASSWORD=bridge_password_changeme
POSTGRES_WRITER_USER=bridge_writer
POSTGRES_WRITER_PASSWORD=writer_password_changeme
DATABASE_READER_URL=postgres://bridge_reader:bridge_password_changeme@postgres-primary:5432/postgres
DATABASE_WRITER_URL=postgres://bridge_writer:writer_password_changeme@postgres-primary:5432/postgres

# ─── the bridge's own runtime ────────────────────────────────────────────────
BRIDGE_CDC_PUBLICATION=my_pub
BRIDGE_CDC_SLOT=my_slot
NATS_URL=nats://nats-server:4222
BRIDGE_PORT=27434
# The HOST port the bridge's telemetry is published on. Separate from BRIDGE_PORT for
# the same reason PG_PUBLISH_PORT is separate from PG_PORT: the host dev loop usually
# has a bridge on 9090 already, and a collision here fails the whole `up`.
BRIDGE_PUBLISH_PORT=27434
# The browser's one port: nginx in front of the bridge's HTTP and NATS's websocket.
# See edge/nginx.conf for what it serves.
PROXY_PUBLISH_PORT=8090
LOG_LEVEL=info
GENERATIONS_ENABLED=1
GENERATION_CADENCE_SECONDS=300
ZB_PROFILE=write

# ─── NATS: the admin seed nats-init uses, and the demo principals ────────────
# ⚠️ Passed on the command line in the host setup; here it is a file value
# because compose has no other way to hand it to the init container.
OPEN_TENANT=_default
NATS_ALICE_PASSWORD=s3cret
NATS_BOB_PASSWORD=s3cret
NATS_MARY_PASSWORD=s3cret
NATS_NINA_PASSWORD=s3cret
NATS_JOHN_PASSWORD=s3cret

