# PG_URL=postgresql://postgres:postgres_paww@postgres:5432/postgres
PG_HOST=127.0.0.1
PG_PORT=5432
PG_PUBLISH_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres_password
PG_DB=postgres
TARGET_DB=postgres

POSTGRES_BRIDGE_USER=bridge_reader
POSTGRES_BRIDGE_PASSWORD=bridge_password_changeme
# Ingress role. Separate from bridge_reader on purpose: the read path keeps
# SELECT + REPLICATION and stays physically unable to write, whatever the write
# path grows into. Created with NO table privileges — open tables one at a time
# with SELECT zebridge_grant_edge_writes('public.<table>').
POSTGRES_WRITER_USER=bridge_writer
POSTGRES_WRITER_PASSWORD=writer_password_changeme

BRIDGE_PORT=9090
BRIDGE_CDC_SLOT=my_slot

LOG_LEVEL=info


BRIDGE_CDC_PUBLICATION=my_pub
BRIDGE_CDC_TABLES=test_types, users

NATS_HOST=127.0.0.1
NATS_URL=nats://127.0.0.1:4222
NATS_BRIDGE_NKEY_PUB=UBZIPHB3HH2J7KJRV6MJVZVDEJA6CD5TYQ6E4K6YZEBWZC7OAHMWFER3
NATS_NKEY_SEED=SUAPSL67RKOUDZFREHHDWUXDXLYZKEHMWEXMIUC35Z4Z2LXWP55SWVJS4Q

# Semantic Event Routing (optional)
# Configure per-table transition rules for intelligent routing of UPDATE events
# Format: "table1:col1,col2;table2:col3,col4"
# When a monitored column changes value, the event is routed to:
#   - cdc.<table>.update.transition (business logic state change)
#   - cdc.<table>.update.data (regular data update)
# Tables without rules: no suffix, backward compatible behavior
# Example: Monitor "status" and "kyc_level" on users, "state" on orders
# TRANSITION_RULES=users:status,kyc_level;orders:state,payment_status