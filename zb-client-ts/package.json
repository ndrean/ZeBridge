{
  "name": "@zebridge/client",
  "version": "0.1.0",
  "type": "module",
  "description": "ZeBridge client: an offline-first SQLite replica of PostgreSQL tables, kept in sync over NATS JetStream, for browsers and Node",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ndrean/zebridge.git",
    "directory": "zb-client-ts"
  },
  "homepage": "https://github.com/ndrean/zebridge/blob/main/CLIENTS.md",
  "bugs": "https://github.com/ndrean/zebridge/issues",
  "keywords": [
    "postgresql",
    "nats",
    "jetstream",
    "offline-first",
    "sqlite",
    "replica",
    "sync",
    "cdc"
  ],
  "engines": {
    "node": ">=22.15"
  },
  "main": "src/entry-browser.ts",
  "types": "src/entry-browser.ts",
  "exports": {
    ".": {
      "browser": "./src/entry-browser.ts",
      "node": "./src/entry-node.ts",
      "default": "./src/entry-browser.ts"
    },
    "./node": "./src/entry-node.ts",
    "./browser": "./src/entry-browser.ts",
    "./storage": "./src/storage.ts",
    "./wasm/zb_core.wasm": "./wasm/zb_core.wasm"
  },
  "files": [
    "dist",
    "wasm/zb_core.wasm",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/entry-browser.js",
    "types": "./dist/entry-browser.d.ts",
    "exports": {
      ".": {
        "browser": {
          "types": "./dist/entry-browser.d.ts",
          "default": "./dist/entry-browser.js"
        },
        "node": {
          "types": "./dist/entry-node.d.ts",
          "default": "./dist/entry-node.js"
        },
        "default": {
          "types": "./dist/entry-browser.d.ts",
          "default": "./dist/entry-browser.js"
        }
      },
      "./node": {
        "types": "./dist/entry-node.d.ts",
        "default": "./dist/entry-node.js"
      },
      "./browser": {
        "types": "./dist/entry-browser.d.ts",
        "default": "./dist/entry-browser.js"
      },
      "./storage": {
        "types": "./dist/storage.d.ts",
        "default": "./dist/storage.js"
      },
      "./wasm/zb_core.wasm": "./wasm/zb_core.wasm"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/core.test.ts",
    "wasm": "cd ../libzb && zig build wasm-core && cp zig-out/wasm/zb_core.wasm ../zb-client-ts/wasm/zb_core.wasm",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "cp ../LICENSE LICENSE && pnpm run build",
    "prepublishOnly": "pnpm run typecheck && pnpm test"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@msgpack/msgpack": "^3.0.0-beta.1",
    "@nats-io/jetstream": "^3.4.0",
    "@nats-io/kv": "^3.4.0",
    "@nats-io/nats-core": "^3.4.0",
    "@nats-io/nkeys": "^2.0.3",
    "@nats-io/obj": "3.4.0",
    "fzstd": "^0.1.1",
    "js-sha256": "^0.11.1",
    "sqlocal": "^0.18.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@nats-io/transport-node": "^3.4.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^24.3.0",
    "better-sqlite3": "^12.4.1",
    "typescript": "^5.7.2"
  },
  "peerDependencies": {
    "@nats-io/transport-node": ">=3",
    "better-sqlite3": ">=11"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    },
    "@nats-io/transport-node": {
      "optional": true
    }
  }
}
