{
  "name": "zb-client-ts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ZeBridge client library: local SQLite replica synchronized over NATS/JetStream",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.0.0-beta.1",
    "@nats-io/jetstream": "^3.4.0",
    "@nats-io/kv": "^3.4.0",
    "@nats-io/nats-core": "^3.4.0",
    "@nats-io/obj": "3.4.0",
    "sqlocal": "^0.18.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "better-sqlite3": "^12.4.1",
    "@nats-io/transport-node": "^3.4.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^24.3.0"
