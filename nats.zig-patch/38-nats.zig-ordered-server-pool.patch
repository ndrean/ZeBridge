+test "server selection preserves configured order across failures and retries" {
+    var pool = ServerPool.init(std.testing.allocator);
+    defer pool.deinit();
+    for ([_][]const u8{ "nats://leaf:4222", "nats://hub:4222", "nats://standby:4222", "nats://last:4222" }) |url| {
+        _ = try pool.addServer(url, false);
+    }
+    var current = (try pool.getNextServer(100, null)).?;
+    for ([_][]const u8{ "hub:4222", "standby:4222", "last:4222", "leaf:4222", "hub:4222" }) |key| {
+        current = (try pool.getNextServer(100, current)).?;
+        try std.testing.expectEqualStrings(key, current.key);
+    }
+}
+
+test "exhausting a server does not reorder remaining endpoints" {
+    var pool = ServerPool.init(std.testing.allocator);
+    defer pool.deinit();
+    for ([_][]const u8{ "nats://leaf:4222", "nats://hub:4222", "nats://standby:4222" }) |url| {
+        _ = try pool.addServer(url, false);
+    }
+    const first = (try pool.getNextServer(5, null)).?;
+    first.reconnects = 5;
+    const next = (try pool.getNextServer(5, first)).?;
+    try std.testing.expectEqualStrings("hub:4222", next.key);
+    try std.testing.expectEqual(@as(usize, 2), pool.getSize());
+}
