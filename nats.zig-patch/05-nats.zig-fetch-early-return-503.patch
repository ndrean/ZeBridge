diff --git a/tests/jetstream_pull_test.zig b/tests/jetstream_pull_test.zig
index f6453fa..7a80f03 100644
--- a/tests/jetstream_pull_test.zig
+++ b/tests/jetstream_pull_test.zig
@@ -50,7 +50,7 @@ test "JetStream pull consumer basic fetch" {
     defer batch.deinit();
 
     // Verify we got the expected messages
-    try testing.expectEqual(null, batch.err);
+    try testing.expectEqual(null, batch.err); // always null now — see MessageBatch.err
