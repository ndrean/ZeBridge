+    /// The outstanding request still owes messages and has not expired.
+    fn requestOpen(self: *PullSubscription) bool {
+        if (self.req_reply_len == 0 or self.req_left == 0) return false;
+        const d = self.req_deadline.toDurationFromNow(self.js.nc.io) orelse return false;
+        return d.raw.toNanoseconds() > 0;
+    }
+
+    fn requestReply(self: *const PullSubscription) []const u8 {
+        return self.req_reply[0..self.req_reply_len];
+    }
+
+    fn requestStart(self: *PullSubscription, reply: []const u8, batch: usize, deadline: Io.Timeout) void {
+        const n = @min(reply.len, self.req_reply.len);
+        @memcpy(self.req_reply[0..n], reply[0..n]);
+        self.req_reply_len = n;
+        self.req_left = batch;
+        self.req_deadline = deadline;
+    }
+
+    fn requestDelivered(self: *PullSubscription) void {
+        if (self.req_left > 0) self.req_left -= 1;
+        if (self.req_left == 0) self.req_reply_len = 0;
+    }
+
+    fn requestEnd(self: *PullSubscription) void {
+        self.req_reply_len = 0;
+        self.req_left = 0;
+    }
