# Copy to .env next to compose.yml, fill in, chmod 600. Never commit .env.
# Passwords: letters and digits only (they go inside URLs), e.g. `openssl rand -hex 24`.

# PostgreSQL in this stack: every docker compose command (up, down, logs) then includes it.
# Remove this line for an external PostgreSQL (its URLs below).
COMPOSE_PROFILES=postgres

# The image tag: a release (ghcr.io/ndrean/zebridge).
ZB_VERSION=0.2.8

# Three DNS names pointing at this server (A, and AAAA if it has IPv6), e.g. bridge.,
# ws. and nats. under your domain. Left empty, compose refuses to start and names them.
BRIDGE_HOST=     # /enroll /renew /status, through HAProxy
WS_HOST=         # browsers: the NATS websocket, through HAProxy
NATS_HOST=       # native clients: NATS with TLS
# The host port for native clients. 4222 unless something on the server already holds it.
NATS_PUBLIC_PORT=4222

# Let's Encrypt: expiry notices go here.
ACME_EMAIL=

# PostgreSQL in this stack (COMPOSE_PROFILES=postgres): the server's superuser, the two
# roles the bridge uses, and zb_inviter, the login a backend uses to create invites (it may
# do nothing else). pg-init creates them with these passwords.
PG_ADMIN_PASSWORD=
ZB_READER_PASSWORD=
ZB_WRITER_PASSWORD=
ZB_INVITER_PASSWORD=

# An external PostgreSQL instead (no COMPOSE_PROFILES): its URLs, which win over the
# passwords above. Set up its database once with pg-init (README.md).
# DATABASE_READER_URL=postgres://zb_reader:…@db.example.com:5432/app?sslmode=require
# DATABASE_WRITER_URL=postgres://zb_writer:…@db.example.com:5432/app?sslmode=require

# Telemetry (COMPOSE_PROFILES=…,telemetry): Alloy sends the metrics to a Prometheus
# remote-write endpoint and the logs to a Loki push endpoint (README.md, "Metrics and logs").
# Grafana Cloud: its Prometheus and Loki URLs, instance IDs and an access-policy token.
# OpenObserve: https://<host>/api/<org>/prometheus/api/v1/write and
# https://<host>/api/<org>/loki/api/v1/push, with the same user and password for both.
# ZB_METRICS_URL=
# ZB_METRICS_USER=
# ZB_METRICS_PASSWORD=
# ZB_LOGS_URL=
# ZB_LOGS_USER=
# ZB_LOGS_PASSWORD=
# The `environment` label, so two hubs can share one store:
# ZB_TELEMETRY_ENVIRONMENT=production

# Sensor readings and their archive (compose.readings.yml, README.md): the second file in
# every command, and the bucket. The S3 keys go in each tenant's own env files, not here.
# COMPOSE_FILE=compose.yml:compose.readings.yml
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_BUCKET=zb-events

BRIDGE_CDC_PUBLICATION=zb_pub
BRIDGE_CDC_SLOT=zb_slot

# The bridge's event buffer, 2^BASE_BUF bytes per slot: raise only, never lower below
# what is stored (bridge --diagnose). 13 = 8 KB.
BASE_BUF=13

# Hub admission normalizes writes onto one private subject per principal. The count
# cap is reduced if needed to fit the byte budget, including record overhead.
# Existing installations need the reviewed empty-queue cutover in README.md first.
MUTATION_BACKLOG_PER_PRINCIPAL=5000
MUTATION_BACKLOG_BYTES_PER_PRINCIPAL=67108864
MUTATION_MAX_MESSAGE_BYTES=65536
MUTATION_STREAM_MAX_BYTES=1073741824
MUTATION_RATE_PER_PRINCIPAL=100
MUTATION_RATE_BURST=200

# Reserved namespaces registered in zebridge_leaf_scopes (space-separated).
ZB_LEAF_NAMES=
