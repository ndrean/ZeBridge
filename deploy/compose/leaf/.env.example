# Copy to .env next to compose.yml and fill in. Never commit .env.
# Beside them, hub/trust.conf and hub/leaf.creds, from the hub's operator (README.md).
# A seeding leaf also needs hub/keeper.creds (--mint-leaf --keeper): separate,
# loopback-only local administration; leaf.creds itself cannot administer streams.

# This leaf's DNS name (A, and AAAA if it has IPv6): its certificate's name, and what
# devices dial (tls://<LEAF_HOST>:4222, wss://<LEAF_HOST>).
LEAF_NAME=
LEAF_HOST=

# The hub's NATS name: the leaf dials tls://<HUB_NATS_HOST>:7422. The hub's firewall must
# let this server's addresses in on 7422.
HUB_NATS_HOST=

# Let's Encrypt: expiry notices go here.
ACME_EMAIL=

# The web apps whose pages may open the websocket, a JSON list, e.g. ["https://app.example.com"].
ALLOWED_ORIGINS=

# The host ports: native clients, and browsers. 4222 and 443 unless something on the
# server already holds them.
NATS_PUBLIC_PORT=4222
LEAF_WS_PORT=443

# A seeding leaf (mirrors of the hub's snapshots): its own JetStream domain, a name unlike
# the hub's. Needs credentials minted with `bridge --mint-leaf --mirror`. Empty: no JetStream.
LEAF_JS_DOMAIN=
# The tenants this leaf serves, space-separated: their snapshots are mirrored (the public
# tables always are). Required; empty is refused. The hub's JetStream domain, if not `hub`.
LEAF_TENANTS=
# HUB_JS_DOMAIN=hub

# Public signed account claims, served by the hub bridge over HTTPS. The leaf
# stops NATS after this many seconds without a verified refresh, then recovers.
TRUST_FEED_URL=https://bridge.example.com/nats-account
TRUST_MAX_STALE_SECONDS=300
