// Grafana Alloy in the compose stack (profile "telemetry"): scrapes the bridge and the NATS
// exporter, reads the containers' logs from the host's journal, and sends the metrics to one
// Prometheus remote-write endpoint and the logs to one Loki push endpoint, whatever store is
// behind them: Grafana Cloud, OpenObserve, Mimir/Loki. Every address and credential comes
// from .env (README.md, "Metrics and logs"), never from this file.
//
// No Docker socket: the bridge reports its own CPU and memory on /metrics
// (bridge_cpu_seconds_total, process_resident_memory_bytes), nats-server through the
// exporter (varz), and the services log with Docker's journald driver, which this reads.

// ── metrics ──────────────────────────────────────────────────────────────────
prometheus.scrape "zebridge" {
  targets         = [{__address__ = "bridge:27434", service = "cdc-bridge"}]
  job_name        = "zebridge"
  scrape_interval = "15s"
  forward_to      = [prometheus.relabel.common.receiver]
}

prometheus.scrape "nats" {
  targets         = [{__address__ = "nats-exporter:7777", service = "nats-server"}]
  job_name        = "nats"
  scrape_interval = "15s"
  forward_to      = [prometheus.relabel.common.receiver]
}

prometheus.relabel "common" {
  forward_to = [prometheus.remote_write.store.receiver]
  // Not the series of each JetStream consumer (`-jsz all` exports a set per consumer):
  // every device holds its own consumers, named anew at each connection, so a fleet
  // starting at once makes thousands of new series (500 devices went past Grafana Cloud's
  // 15,000 active-series limit, and every batch was refused). The per-stream series stay.
  rule {
    source_labels = ["__name__"]
    regex         = "jetstream_consumer_.*"
    action        = "drop"
  }
  // Which hub this is, so two of them can share one store and one dashboard.
  rule {
    target_label = "environment"
    replacement  = coalesce(sys.env("ZB_TELEMETRY_ENVIRONMENT"), "production")
  }
}

prometheus.remote_write "store" {
  endpoint {
    url = sys.env("ZB_METRICS_URL")
    basic_auth {
      username = sys.env("ZB_METRICS_USER")
      password = sys.env("ZB_METRICS_PASSWORD")
    }
  }
}

// ── logs: the containers' lines in the host journal ──────────────────────────
loki.relabel "journal" {
  forward_to = []
  // Docker's journald driver tags each line with the container's name; a line without one
  // is the host's own, not this stack's.
  rule {
    source_labels = ["__journal_container_name"]
    regex         = ""
    action        = "drop"
  }
  rule {
    source_labels = ["__journal_container_name"]
    target_label  = "container"
  }
}

loki.source.journal "containers" {
  max_age       = "1h"   // what happens from now on, not the journal's whole history
  relabel_rules = loki.relabel.journal.rules
  labels        = {environment = coalesce(sys.env("ZB_TELEMETRY_ENVIRONMENT"), "production")}
  forward_to    = [loki.process.zebridge.receiver]
}

loki.process "zebridge" {
  // The bridge, admission and the sweeper: the dev stack's and the systemd hub's labels.
  stage.match {
    selector = "{container=~\".*-(bridge|admission|sweeper)-[0-9]+\"}"
    stage.static_labels {
      values = {service = "cdc-bridge"}
    }
    // the bridge logs `info(fleet): …`, `warning(preflight): …`: level and scope
    stage.regex {
      expression = "^(?P<level>debug|info|warning|error)\\((?P<scope>[a-z_]+)\\):"
    }
    stage.labels {
      values = {level = "", scope = ""}
    }
  }
  stage.match {
    selector = "{container=~\".*-nats-[0-9]+\"}"
    stage.static_labels {
      values = {service = "nats-server"}
    }
    // nats-server logs `[pid] date time [INF] …`
    stage.regex {
      expression = "\\[(?P<level>INF|WRN|ERR|DBG|FTL|TRC)\\]"
    }
    stage.labels {
      values = {level = ""}
    }
  }
  forward_to = [loki.write.store.receiver]
}

loki.write "store" {
  endpoint {
    url = sys.env("ZB_LOGS_URL")
    basic_auth {
      username = sys.env("ZB_LOGS_USER")
      password = sys.env("ZB_LOGS_PASSWORD")
    }
  }
}
