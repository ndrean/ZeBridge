reorganize.py
test_map.zig
seed.txt
# The pre-split .env, removed 2026-08-28. The three files that replaced it
# (.env.bridge, .env.docker, .env.admin) are tracked; a bare .env is not, so a
# local scratch copy cannot drift back into the repo.
# /.env

# Vite's local overrides. `.env.local` is per-developer by convention and by name —
# which stack you happen to be pointed at, and (via VITE_AUTH) which credential that
# broker accepts. `.env.compose.example` is the tracked copy worth reading.
examples/05-tables/web-consumer/.env.local
examples/05-tables/web-consumer/.env.*.local
libzb/soak-uids.txt
libzb/zbz-*.sqlite3*
zb-client-ts/zebridge_*.sqlite3
zb-client-ts/zebridge_*.sqlite3-*

# R2 bucket (tiles, sensors bucket)
.env.bucket
# The Central Portal token for Maven (CI reads it from the repository's secrets)
.env.maven

.env.grafana
# A cloud PostgreSQL's connection strings (the Supabase demo project): never committed.
.env.supabase
# The compose stack's settings and passwords, on the server only.
deploy/compose/.env
/node_modules/
# every package and example installs its own: none is ever committed
node_modules/

examples/08-map/**/.env*
examples/08-map/flutter/data/
# The map's raw datasets: downloaded, large, and rebuilt by their loaders (§10hr).
examples/08-map/poi-ocm.json

# Python bytecode, anywhere (the three per-directory rules above are covered by this one)
__pycache__/
*.pyc

# zb-client-ts commits its lockfile (CI installs it with --frozen-lockfile). The examples
# link the local packages, so their lockfiles stay local; the root one only pins pnpm.
# zb-react-native's too: CI only packs it (pnpm pack installs nothing).
/pnpm-lock.yaml
examples/**/pnpm-lock.yaml
zb-react-native/pnpm-lock.yaml
# …except the quickstart's two pages: their images are published (quickstart/Dockerfile.web,
# quickstart/Dockerfile.survey), built with --frozen-lockfile.
!examples/05-tables/web-consumer/pnpm-lock.yaml
!examples/15-shared-record/web/pnpm-lock.yaml
examples/08-map/prix-des-carburants-en-france-flux-instantane-v2.csv
zb.sqlite*

# `bridge --init-nats` output: seeds, creds and .env.bridge (mode 0600). Never committed.
/zb-nats/

# release packages (deploy/package-linux.sh)
dist/

# a CLI tool's own settings (Cloudsmith), local only
/config.ini

# NATS credentials, wherever they land (an scp into the root, a test folder): never committed
*.creds

# Gradle caches (a module built inside an app, e.g. zb-react-native/android)
.gradle/

# Flutter/Dart local overrides (e.g. an example pointed at the local zb-dart): never committed,
# an app with one cannot build against pub.dev.
pubspec_overrides.yaml
