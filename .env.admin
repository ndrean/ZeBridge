# ─────────────────────────────────────────────────────────────────────────────
# ADMIN — superuser credentials and the roles init.sql creates.
#
# Read by two things only:
#   • docker compose itself, to interpolate ${PG_USER}/${PG_PASSWORD} into
#     postgres-primary
#   • the `bridge-init` container, which runs `envsubst < init.sql.template | psql`
#     as the superuser once Postgres is healthy
#
# The **bridge never reads any of this**. It connects with DATABASE_URL and
# DATABASE_WRITER_URL, in .env.bridge. The two families lived in one file and were
# easy to mistake for each other: the bridge logged "PG_PORT not set, using default:
# 5432" while actually connecting to 55432, because a URL was set and won.
#
# Compose is given this file and only this file — every service it starts is an admin
# task (the Postgres bootstrap, init.sql, the NATS config, stream creation):
#
#   NATS_NKEY_SEED="SU..." docker compose -f docker-compose.full.yml \
#     --env-file .env.admin up -d
#
# Keep this file out of the shell you launch the bridge from — sourcing only
# .env.bridge is what makes "the bridge cannot see admin credentials" true rather
# than merely intended.
# ─────────────────────────────────────────────────────────────────────────────

# Superuser. PG_HOST/PG_PORT are the *in-network* address: bridge-init runs inside
# compose, so it reaches Postgres by service name on 5432, not through the published
# host port.
PG_HOST=postgres-primary
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres_password
PG_DB=postgres

ADMIN_DATABASE_URL=postgres://postgres:postgres_password@127.0.0.1:5432/postgres
# Host port compose publishes Postgres on. The bridge's DATABASE_URL in .env.bridge
# must name this same port — compose reads this file, so this is the effective value.
PG_PUBLISH_PORT=55432

# Database init.sql grants the roles into. Separate from PG_DB so the template can
# target a database other than the one you connect to.
TARGET_DB=postgres

# Read role: SELECT + REPLICATION, physically unable to write.
POSTGRES_BRIDGE_USER=bridge_reader
POSTGRES_BRIDGE_PASSWORD=bridge_password_changeme

# Ingress role. Separate from bridge_reader on purpose: the read path keeps SELECT +
# REPLICATION and stays unable to write, whatever the write path grows into. Created
# with NO table privileges — open tables one at a time with
# SELECT zebridge_grant_edge_writes('public.<table>').
POSTGRES_WRITER_USER=bridge_writer
POSTGRES_WRITER_PASSWORD=writer_password_changeme


NATS_NKEY_SEED=SUAPSL67RKOUDZFREHHDWUXDXLYZKEHMWEXMIUC35Z4Z2LXWP55SWVJS4Q

# init.sql.template also interpolates this, to create the publication.
BRIDGE_CDC_PUBLICATION=my_pub

# The OPEN tenant: the value `zebridge_guard_tenant()` writes into a tenant column that a
# writer left NULL or empty. Its rows publish on `cdc.<OPEN_TENANT>.<table>.<op>`, which
# no declared tenant's stream captures — so the same value is rendered into THREE more
# places that must agree, and that is why it is an env rather than a literal:
#   • bridge-init      → the guard's default            (envsubst, init.write.template.sql)
#   • nats-init        → a subject of the CDC_PUBLIC stream, so the rows land somewhere
#   • nats-config-gen  → `cdc.${OPEN_TENANT}.>` in every principal's read grant
# `scripts/scenarios/check.py` §9 compares them. A legal NATS token: no `.`, ` `, `*`, `>`,
# and NOT one of topology.json's `tenants` (its stream would overlap CDC_PUBLIC, and NATS
# refuses overlapping streams, which would leave the public stream uncreated).
# Open means open to READ. Writes still go through `zebridge_user_tenants`: map a
# principal (or zb_sweeper) to this value to let it write or reap open rows.
OPEN_TENANT=_default

# ─── NATS authorization ──────────────────────────────────────────────────────
#
# The bridge's nkey PUBLIC half. `nats-config-gen` substitutes it into
# nats-server.conf, i.e. this is the server being told whom to trust — an
# authorization decision, not a credential. The bridge holds the matching seed and
# receives it on the command line; it never needs this value.
NATS_BRIDGE_NKEY_PUB=UBZIPHB3HH2J7KJRV6MJVZVDEJA6CD5TYQ6E4K6YZEBWZC7OAHMWFER3

# A client principal's password, substituted into nats-server.conf the same way and for
# the same reason: this is the server being told what `alice` may do, not a credential
# the bridge uses. The bridge never authenticates as a client and must not have it.
#
# Prefer a bcrypt hash over clear text — `nats server passwd` prints a `$2a$…` string
# that goes here verbatim, and the client keeps sending the plain password.
#
# ⚠️ Dev value, and it is in git. Rotate before this is reachable by anyone else: it is
# the only thing standing between an untrusted network and write access as `alice`.
NATS_ALICE_PASSWORD=s3cret

# `john`: mapped to OPEN_TENANT (`_default`) in `zebridge_user_tenants`, not to a
# private tenant — the public-only principal, exercising the open-bar write policy and
# the no-entry-in-KV.tenants read path (NOTES.md §1.12 part 3, "for audit consistency
# you'd still want [an open-tenant writer] mapped either way").
NATS_JOHN_PASSWORD=s3cret

# The matching SEED is deliberately in no file. It is still needed at `up` time, though:
# the server rejects unauthenticated clients (`Authorization Violation`), and `nats-init`
# authenticates with this key to create the streams. Compose takes it from the shell —
#
#   NATS_NKEY_SEED="SU..." docker compose -f docker-compose.full.yml \
#     --env-file .env.admin up -d
#
# — and with it unset, nats-init writes an empty seed file and spins in its
# "Waiting for NATS server..." loop while no stream is ever created.

# How long the REQUESTS stream holds one snapshot request per table, and so how long
# a request for a table that already has a valid snapshot is refused. The production
# default (docker-compose.full.yml) is ~7 days minus a safety margin — matching
# INIT's own retention, since a snapshot is good for as long as INIT keeps it. 60
# here is a dev-only override, short enough to actually exercise the "existing
# snapshot expired, a new request is now allowed" path without waiting days for it.
# Read by nats-init when it creates the stream, never by the bridge.
SNAP_RET_SECONDS=60
NATS_BOB_PASSWORD=s3cret

# ─── Setup profile ───────────────────────────────────────────────────────────
#
# Which half of the schema `bridge-init` installs.
#
#   readonly   init.core.sql.template only — CDC and snapshots. No writer role, no RLS,
#              no tombstone guards, no zebridge_user_tenants. A deployment that only
#              reads PostgreSQL never has to meet any of it.
#   write      (default, and anything not "readonly") core + init.write.sql.template:
#              adds the writer role and the ingress machinery.
#
# ⚠️ Multi-tenant is NOT a profile. It is two calls and one bridge setting, applied per
# table after either profile is installed:
#
#   INSERT INTO zebridge_user_tenants (principal, tenant_id) VALUES ('alice','acme');
#   SELECT zebridge_scope_writes_by_tenant('public.orders','tenant_id');
#   TENANT_RULES=orders:tenant_id     <- in the BRIDGE's env; this one needs a restart,
#                                        the two SQL calls above take effect immediately.
ZB_PROFILE=write
