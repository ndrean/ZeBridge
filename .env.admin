# ─────────────────────────────────────────────────────────────────────────────
# ADMIN — superuser credentials and the roles init.sql creates.
#
# Read by two things only:
#   • docker compose itself, to interpolate ${PG_USER}/${PG_PASSWORD} into
#     postgres-primary
#   • the `bridge-init` container, which runs `envsubst < init.sql.template | psql`
#     as the superuser once Postgres is healthy
#
# The **bridge never reads any of this**. It connects with DATABASE_URL and
# DATABASE_WRITER_URL, in .env.bridge. The two families lived in one file and were
# easy to mistake for each other: the bridge logged "PG_PORT not set, using default:
# 5432" while actually connecting to 55432, because a URL was set and won.
#
# Compose is given this file and only this file — every service it starts is an admin
# task (the Postgres bootstrap, init.sql, the NATS config, stream creation):
#
#   NATS_NKEY_SEED="SU..." docker compose -f docker-compose.full.yml \
#     --env-file .env.admin up -d
#
# Keep this file out of the shell you launch the bridge from — sourcing only
# .env.bridge is what makes "the bridge cannot see admin credentials" true rather
# than merely intended.
# ─────────────────────────────────────────────────────────────────────────────

# Superuser. PG_HOST/PG_PORT are the *in-network* address: bridge-init runs inside
# compose, so it reaches Postgres by service name on 5432, not through the published
# host port.
PG_HOST=postgres-primary
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres_password
PG_DB=postgres

ADMIN_DATABASE_URL=postgres://postgres:postgres_password@127.0.0.1:55432/postgres
# Host port compose publishes Postgres on. The bridge's DATABASE_URL in .env.bridge
# must name this same port — compose reads this file, so this is the effective value.
PG_PUBLISH_PORT=55432

# Database init.sql grants the roles into. Separate from PG_DB so the template can
# target a database other than the one you connect to.
TARGET_DB=postgres

# Read role: SELECT + REPLICATION, physically unable to write.
POSTGRES_BRIDGE_USER=bridge_reader
POSTGRES_BRIDGE_PASSWORD=bridge_password_changeme

# Ingress role. Separate from bridge_reader on purpose: the read path keeps SELECT +
# REPLICATION and stays unable to write, whatever the write path grows into. Created
# with NO table privileges — open tables one at a time with
# SELECT zebridge_grant_edge_writes('public.<table>').
POSTGRES_WRITER_USER=bridge_writer
POSTGRES_WRITER_PASSWORD=writer_password_changeme

# init.sql.template also interpolates this, to create the publication.
BRIDGE_CDC_PUBLICATION=my_pub

# ─── NATS authorization ──────────────────────────────────────────────────────
#
# The bridge's nkey PUBLIC half. `nats-config-gen` substitutes it into
# nats-server.conf, i.e. this is the server being told whom to trust — an
# authorization decision, not a credential. The bridge holds the matching seed and
# receives it on the command line; it never needs this value.
NATS_BRIDGE_NKEY_PUB=UBZIPHB3HH2J7KJRV6MJVZVDEJA6CD5TYQ6E4K6YZEBWZC7OAHMWFER3

# The matching SEED is deliberately in no file. It is still needed at `up` time, though:
# the server rejects unauthenticated clients (`Authorization Violation`), and `nats-init`
# authenticates with this key to create the streams. Compose takes it from the shell —
#
#   NATS_NKEY_SEED="SU..." docker compose -f docker-compose.full.yml \
#     --env-file .env.admin up -d
#
# — and with it unset, nats-init writes an empty seed file and spins in its
# "Waiting for NATS server..." loop while no stream is ever created.

# How long the REQUESTS stream holds one snapshot request per table: the snapshot
# stampede window, enforced by the broker rather than by clients behaving well.
# Read by nats-init when it creates the stream, never by the bridge.
SNAP_RET_SECONDS=600
