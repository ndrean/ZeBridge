# Host-side env for running the bridge binary directly against the containerised
# PostgreSQL + NATS from docker-compose.full.yml.
#
#   PG_PUBLISH_PORT=55432 docker compose -f docker-compose.full.yml --env-file .env.prod \
#     up -d postgres-primary nats-config-gen nats-server nats-init bridge-init
#   set -a && source .env.local && set +a
#   ./zig-out/bin/bridge --slot my_slot --pub my_pub --port 9090
#
# .env.prod uses container hostnames (postgres-primary, nats-server) which only
# resolve inside the compose network; these are the published host ports instead.
#
# 127.0.0.1 rather than localhost, and 55432 rather than 5432: this machine runs a
# host Postgres bound to [::1]:5432 and 127.0.0.1:5432. Those specific bindings win
# over Docker's wildcard *:5432, so `localhost` silently reaches the host server
# (which has no bridge_reader role) instead of the container.

PG_HOST=127.0.0.1
PG_PORT=55432
PG_DB=postgres

POSTGRES_BRIDGE_USER=bridge_reader
POSTGRES_BRIDGE_PASSWORD=bridge_password_changeme

# Both ends are local here, so state the transport explicitly rather than
# inheriting libpq's ambiguous `prefer` default.
PG_SSLMODE=disable

NATS_HOST=127.0.0.1
NATS_BRIDGE_USER=bridge_user
NATS_BRIDGE_PASSWORD=bridge_secure_password
