# The browser demo (examples/05-tables/web-consumer), built with zb-client-ts and
# served by nginx. Build context: the repository root.
FROM node:22-alpine AS build
RUN corepack enable
WORKDIR /src
COPY zb-client-ts/ zb-client-ts/
COPY examples/05-tables/web-consumer/ examples/05-tables/web-consumer/
# --ignore-scripts: better-sqlite3 (the Node storage) would compile here, and the
# browser build never loads it.
RUN cd zb-client-ts && pnpm install --frozen-lockfile --ignore-scripts
# The page picks its engine per account; every quickstart tab uses SQLite on OPFS.
ENV VITE_ENGINE=sqlite
RUN cd examples/05-tables/web-consumer && pnpm install --frozen-lockfile && pnpm build

FROM nginx:alpine
COPY quickstart/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/examples/05-tables/web-consumer/dist /usr/share/nginx/html
