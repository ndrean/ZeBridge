          "$JS.API.DIRECT.GET.KV_schemas.>"
          "$JS.API.STREAM.MSG.GET.KV_schemas"

          # See alice's block above for why this is the exact key and not a wildcard.
          "$JS.API.DIRECT.GET.KV_tenants.$KV.tenants.mary"
          "$JS.ACK.>"
        ] }
        subscribe = { allow: $MARY_READ }
    } }

    # ── a fifth principal, third on globex — three independent rows resolving one value ──
    { user: "nina", password: "${NATS_NINA_PASSWORD}", permissions: {
        publish = { allow: [
          "mutation.nina.>"


          "$JS.API.INFO"

